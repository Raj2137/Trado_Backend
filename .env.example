PAPER_TRADING=true
PAPER_TRADING_FEE_RATE=0.001
# SQLite works for local scheduled runs. Set a managed PostgreSQL URL before
# deploying scheduled jobs to a cloud platform.
DATABASE_URL=sqlite:///./data/portfolio_state.db
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
TOTAL_CAPITAL_USDT=100
# Price protection: check exits every minute. Rankings refresh separately.
MONITOR_INTERVAL_SECONDS=60
SCAN_INTERVAL_SECONDS=900
# Fully deploy the approved basket; only exchange fees leave small cash dust.
INITIAL_DEPLOYMENT_RATIO=1.0
MAX_OPEN_POSITIONS=2
# Backtest a wider shortlist, then select only the best two for the basket.
BACKTEST_CANDIDATE_LIMIT=10
MIN_TRADE_SIZE_USDT=5
STOP_LOSS_PCT=0.02
# Stop opening new positions for the calendar day after a 30% equity loss.
DAILY_LOSS_LIMIT_PCT=0.30
# Require enough historical simulated trades and a positive fee-adjusted
# average return before a new position may be opened.
MIN_BACKTEST_TRADES=3
MIN_BACKTEST_NET_AVG_RETURN=0.0
# At +2% net profit, retain a fixed +2% net-profit floor. The position exits
# on the next monitor check below that floor.
PROFIT_LOCK_START_PCT=0.02
PROFIT_LOCK_FLOOR_PCT=0.02
PROFIT_LOCK_DRAWDOWN_PCT=0.0
# A closed coin can only re-enter after 15 minutes and a fresh qualifying scan.
REENTRY_COOLDOWN_SECONDS=900
# LLM research is opt-in and advisory only; it never places exchange orders.
LLM_ADVISOR_ENABLED=false
OPENAI_API_KEY=
LLM_ADVISOR_MODEL=gpt-5-mini
LLM_ADVISOR_INTERVAL_SECONDS=900
# After this time without a successful research response, advice becomes neutral.
LLM_ADVISOR_MAX_AGE_SECONDS=1200
LLM_ADVISOR_TIMEOUT_SECONDS=45
LLM_MIN_CONFIDENCE=0.70
LLM_MAX_RANK_ADJUSTMENT=0.15
